# Virtual Meeting Manager Environment Variables
# Copy this file to .env and fill in your values

# Bubble.io API Configuration
REACT_APP_BUBBLE_API_BASE=https://your-app.bubbleapps.io/api/1.1/wf

# Optional: API Authentication Token (if required)
# REACT_APP_BUBBLE_API_TOKEN=your-api-token-here

# Optional: Enable Debug Mode
# REACT_APP_DEBUG=true
